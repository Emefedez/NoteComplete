{
  "name": "notecomplete-desktop",
  "version": "1.2.74",
  "private": true,
  "description": "NoteComplete document reader and editor",
  "author": "NoteComplete contributors",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "stage": "node stage.mjs",
    "start": "electron .",
    "test": "node --test *.test.mjs",
    "dist": "electron-builder --publish never",
    "prestart": "install-electron"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.notecomplete.desktop",
    "productName": "NoteComplete",
    "artifactName": "NoteComplete-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "permissions.js",
      "asset-path.js",
      "archive-download.js",
      "html-pdf.js",
      "library-files.js",
      "diagrams.js",
      "r-bridge.js",
      "open-with.js",
      "linux-integration.js",
      "ai-runner.js",
      "transcriber.js",
      "terminate-process.js",
      "tabs.js",
      "updater.js",
      "session.js",
      "prefab-folder.js",
      "png-clipboard.js",
      "app-menu.js",
      "app-log.js",
      "agent-setup.js",
      "collab-hub.js",
      "collab-server.js",
      "tunnel.js",
      "package.json",
      "reader/**/*",
      "preload.cjs",
      "google-auth.js",
      "dropbox-auth.js",
      "google-desktop-client.json"
    ],
    "fileAssociations": [
      {
        "ext": "noteful",
        "name": "NoteComplete.Noteful",
        "description": "Noteful note",
        "mimeType": "application/x-noteful",
        "role": "Editor",
        "rank": "Owner"
      },
      {
        "ext": "nfedit",
        "name": "NoteComplete.Project",
        "description": "NoteComplete project",
        "mimeType": "application/x-nfedit",
        "role": "Editor",
        "rank": "Owner"
      },
      {
        "ext": "notecomp",
        "name": "NoteComplete.Package",
        "description": "NoteComplete package",
        "mimeType": "application/x-notecomp",
        "role": "Editor",
        "rank": "Owner"
      },
      {
        "ext": "notecomplete",
        "name": "NoteComplete.Package",
        "description": "NoteComplete package",
        "mimeType": "application/x-notecomp",
        "role": "Editor",
        "rank": "Owner"
      },
      {
        "ext": "notepart",
        "name": "NoteComplete.Part",
        "description": "NoteComplete part",
        "mimeType": "application/x-notepart",
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "fileAssociations": [
        {
          "ext": [
            "pdf"
          ],
          "name": "PDF document",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "png"
          ],
          "name": "PNG image",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "jpg",
            "jpeg"
          ],
          "name": "JPEG image",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "webp"
          ],
          "name": "WebP image",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "gif"
          ],
          "name": "GIF image",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "bmp"
          ],
          "name": "BMP image",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "avif"
          ],
          "name": "AVIF image",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "tar"
          ],
          "name": "Tar archive",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "zip"
          ],
          "name": "ZIP archive",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown document",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "txt"
          ],
          "name": "Plain text",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "html",
            "htm"
          ],
          "name": "HTML page",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "docx",
            "docm",
            "dotx"
          ],
          "name": "Word document",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "doc"
          ],
          "name": "Word 97-2003 document",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "rtf"
          ],
          "name": "Rich Text document",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "odt",
            "fodt"
          ],
          "name": "OpenDocument text",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "xlsx",
            "xlsm",
            "xlsb"
          ],
          "name": "Excel workbook",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "xls"
          ],
          "name": "Excel 97-2003 workbook",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "ods",
            "fods"
          ],
          "name": "OpenDocument spreadsheet",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "pptx",
            "pptm"
          ],
          "name": "PowerPoint presentation",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "ppt"
          ],
          "name": "PowerPoint 97-2003 presentation",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "odp"
          ],
          "name": "OpenDocument presentation",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "epub"
          ],
          "name": "EPUB e-book",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "ipynb"
          ],
          "name": "Jupyter notebook",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "csv"
          ],
          "name": "CSV table",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "tsv"
          ],
          "name": "TSV table",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "mp3"
          ],
          "name": "MP3 audio",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "m4a"
          ],
          "name": "M4A audio",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "wav"
          ],
          "name": "WAV audio",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "ogg",
            "oga",
            "opus"
          ],
          "name": "OGG audio",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "flac"
          ],
          "name": "FLAC audio",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "mp4",
            "m4v"
          ],
          "name": "MP4 video",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "puml",
            "plantuml",
            "pu",
            "iuml",
            "wsd"
          ],
          "name": "PlantUML diagram",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ],
      "extendInfo": {
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.notecomplete.noteful",
            "UTTypeDescription": "Noteful note",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "noteful"
              ],
              "public.mime-type": [
                "application/x-noteful"
              ]
            }
          },
          {
            "UTTypeIdentifier": "com.notecomplete.nfedit",
            "UTTypeDescription": "NoteComplete project",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "nfedit"
              ],
              "public.mime-type": [
                "application/x-nfedit"
              ]
            }
          },
          {
            "UTTypeIdentifier": "com.notecomplete.notecomp",
            "UTTypeDescription": "NoteComplete package",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "notecomp",
                "notecomplete"
              ],
              "public.mime-type": [
                "application/x-notecomp"
              ]
            }
          },
          {
            "UTTypeIdentifier": "com.notecomplete.notepart",
            "UTTypeDescription": "NoteComplete part",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "notepart"
              ],
              "public.mime-type": [
                "application/x-notepart"
              ]
            }
          }
        ]
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "mimeTypes": [
        "application/pdf",
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/gif",
        "image/bmp",
        "image/avif",
        "application/x-tar",
        "application/zip",
        "text/markdown",
        "text/plain",
        "text/html",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/msword",
        "application/rtf",
        "application/vnd.oasis.opendocument.text",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.ms-excel",
        "application/vnd.oasis.opendocument.spreadsheet",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "application/vnd.ms-powerpoint",
        "application/vnd.oasis.opendocument.presentation",
        "application/epub+zip",
        "application/x-ipynb+json",
        "text/csv",
        "text/tab-separated-values",
        "audio/mpeg",
        "audio/mp4",
        "audio/wav",
        "audio/ogg",
        "audio/flac",
        "video/mp4",
        "text/vnd.plantuml"
      ]
    },
    "icon": "build/icon.png",
    "extraResources": [
      {
        "from": "../../target/release",
        "to": ".",
        "filter": [
          "noteful",
          "noteful.exe"
        ]
      }
    ]
  },
  "dependencies": {
    "ws": "8.22.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  }
}
