        "rCode": "x <- seq(-2*pi, 2*pi, length.out = 300)\nplot(x, sin(x), type = 'l', lwd = 2, col = '#245dc4', main = 'sin(x) and cos(x)', ylab = 'y')\nlines(x, cos(x), lwd = 2, col = '#b83228', lty = 2)\nlegend('topright', legend = c('sin(x)', 'cos(x)'), col = c('#245dc4', '#b83228'), lty = c(1, 2), lwd = 2, bty = 'n')",
